{
  "$id": "https://kunqu-player.local/schema/review-manifest-v1.json",
  "type": "object",
  "required": ["schemaVersion", "scoreId", "profile", "sources", "corrections", "sections", "textClassifications", "overrides"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scoreId": { "type": "string", "minLength": 1 },
    "profile": { "type": "string", "minLength": 1 },
    "base": { "type": "object", "properties": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }, "additionalProperties": true },
    "sources": { "type": "array", "items": { "type": "object", "required": ["id", "title", "kind"] } },
    "corrections": { "type": "array" },
    "sections": { "type": "array" },
    "textClassifications": { "type": "array" },
    "overrides": { "type": "array" }
  },
  "additionalProperties": true
}
